{
  "name": "portfolio-lab",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && pnpm --filter @portfolio-lab/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @portfolio-lab/db migrate",
    "db:seed": "pnpm --filter @portfolio-lab/db seed",
    "db:generate": "pnpm --filter @portfolio-lab/db generate",
    "data:ingest": "pnpm --filter @portfolio-lab/data ingest",
    "data:sp500": "pnpm --filter @portfolio-lab/data sp500"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
